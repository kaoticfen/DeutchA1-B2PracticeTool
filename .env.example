# MySQL connection (matches docker-compose defaults)
DATABASE_URL="mysql://deutsch:deutsch@localhost:3306/deutsch"

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-run-openssl-rand-base64-32"

# Only needed to run `npm run generate:seed`. The app never calls the API at runtime.
ANTHROPIC_API_KEY=""
